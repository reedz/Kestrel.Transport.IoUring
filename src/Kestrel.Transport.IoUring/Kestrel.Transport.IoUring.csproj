<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- PtsLibraryTfm lets the Phoronix profile build only the framework it runs (avoids restoring unused targeting packs). -->
    <TargetFrameworks Condition="'$(PtsLibraryTfm)' == ''">net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(PtsLibraryTfm)' != ''">$(PtsLibraryTfm)</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <PackageId>Kestrel.Transport.IoUring</PackageId>
    <Version>2.3.0</Version>
    <Authors>reedz</Authors>
    <Description>Production-oriented io_uring transport for ASP.NET Core Kestrel with multishot accept/receive, provided buffer rings, lifecycle-safe cancellation, multi-ring listeners, and SocketTransport fallback.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/reedz/Kestrel.Transport.IoUring</PackageProjectUrl>
    <RepositoryUrl>https://github.com/reedz/Kestrel.Transport.IoUring</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>io_uring;kestrel;aspnetcore;transport;linux;high-performance;networking</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 reedz</Copyright>
    <PackageReleaseNotes>
v2.3.0
- Fix default ring sizing so the transport binds with default options.
- Drain final response buffers and close connection-churn sockets without fd leaks.
- Make abort, send-pin, fixed-file, slot, and shutdown lifetimes IO-loop-owned.
- Enforce multishot receive backpressure with cancellation and bounded buffering.
- Retry SQ-full control/send operations and back off accept/ENOBUFS resource errors.
- Fail safely on CQ overflow and isolate completion-dispatch failures.
- Add endpoint metadata, port-zero, UDS fallback, and multi-listener correctness.
- Add multi-target tests, CI, and reproducible epoll throughput/CPU/latency gates.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- SourceLink needs a git checkout and a NuGet restore; neither exists in the Phoronix source bundle, which builds offline. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" Condition="'$(PtsLibraryTfm)' == ''" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kestrel.Transport.IoUring.Tests" />
  </ItemGroup>
</Project>
