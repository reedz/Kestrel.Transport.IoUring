#!/bin/bash
# Installs everything the profile needs into the PTS install directory ($HOME == install dir):
#   pts-source/      the Kestrel.Transport.IoUring source bundle (server app + runtime scripts)
#   dotnet10/ dotnet11/   user-space SDKs (no system .NET required, nothing outside this directory is touched)
#   wrk-4.2.0/       load generator (same version as the nginx/apache profiles)
#   wwwroot/         test.html from the PTS http-test-files package
#   publish/net10, publish/net11   the ASP.NET Core server built for each runtime
#
# The install is OFFLINE: every download is supplied by PTS from its download cache (see fetch-artifacts.sh), and
# the build restores nothing from NuGet (the SDKs ship the reference packs; an empty local source makes any
# attempt to reach nuget.org fail instead of silently succeeding). PTS therefore never needs network access.
#
# make-bundle.sh fills the @...@ placeholders so that this script identifies, and verifies, the exact source bundle
# and every third-party archive.

fail() {
    echo "ERROR: $*"
    echo 1 > ~/install-exit-status
    exit 1
}

cd ~ || fail "cannot cd to the install directory"

SRC_BUNDLE="@SRC_FILE@"
SRC_SHA256="@SRC_SHA256@"
SOURCE_COMMIT="@SOURCE_COMMIT@"
SDK10="dotnet-sdk-10.0.402-linux-x64.tar.gz"
SDK11="dotnet-sdk-11.0.100-rc.2.26504.105-linux-x64.tar.gz"

command -v curl > /dev/null || fail "curl is required (the profile verifies the server with it)"

for f in "$SRC_BUNDLE" "$SDK10" wrk-4.2.0.tar.gz http-test-files-1.tar.xz; do
    [ -f "$f" ] || fail "missing download $f"
done

# PTS keeps a download that already exists in the install directory without re-hashing it, so a stale bundle from
# an earlier install must never be used: the bundle name carries the commit and the hash is checked here.
for old in aspnet-kestrel-iouring-src*.tar.gz; do
    [ "$old" = "$SRC_BUNDLE" ] || rm -f "$old"
done
echo "$SRC_SHA256  $SRC_BUNDLE" | sha256sum --check --status || fail "$SRC_BUNDLE does not match the expected SHA-256 $SRC_SHA256"

# PTS also skips hashing every other download that already sits in the install directory, so each archive is
# verified here against the digests baked in from downloads.xml.in, before anything is extracted.
ARCHIVE_SHA256="$(cat <<'EOF_ARCHIVES'
@ARCHIVE_SHA256_LIST@
EOF_ARCHIVES
)"
while read -r expected_sha archive_name; do
    [ -n "$archive_name" ] || continue
    echo "$expected_sha  $archive_name" | sha256sum --check --status || fail "$archive_name does not match the expected SHA-256 $expected_sha"
done <<< "$ARCHIVE_SHA256"

# 1. Source bundle (also carries the runtime scripts used by pre.sh, post.sh and the run wrapper).
rm -rf pts-source && mkdir pts-source || fail "cannot create pts-source"
tar -xzf "$SRC_BUNDLE" -C pts-source || fail "cannot unpack $SRC_BUNDLE"

# 2. SDKs.
rm -rf dotnet10 && mkdir dotnet10 && tar -xzf "$SDK10" -C dotnet10 || fail "cannot unpack $SDK10"
{
    [ -f "$SDK11" ] || fail "missing download $SDK11"
    rm -rf dotnet11 && mkdir dotnet11 && tar -xzf "$SDK11" -C dotnet11 || fail "cannot unpack $SDK11"

    # The server for .NET 11 consumes the library's net10.0 asset, which SDK 11 can only compile against the
    # net10.0 reference packs. SDK 10 ships exactly those; link them in instead of downloading them.
    for pack in Microsoft.NETCore.App.Ref Microsoft.AspNetCore.App.Ref; do
        for version_dir in dotnet10/packs/"$pack"/*; do
            version="$(basename "$version_dir")"
            [ -d "$version_dir" ] || continue
            [ -e "dotnet11/packs/$pack/$version" ] && continue
            mkdir -p "dotnet11/packs/$pack"
            ln -s "../../../dotnet10/packs/$pack/$version" "dotnet11/packs/$pack/$version" \
                || fail "cannot link the $pack $version reference pack"
        done
    done
}

# 3. wrk.
rm -rf wrk-4.2.0 && tar -xzf wrk-4.2.0.tar.gz || fail "cannot unpack wrk"
( cd wrk-4.2.0 && make -j "${NUM_CPU_CORES:-2}" ) || fail "wrk build failed"
[ -x wrk-4.2.0/wrk ] || fail "wrk binary missing after build"

# 4. Static file served by the 'Static File' workload.
rm -rf http-test-files wwwroot && tar -xJf http-test-files-1.tar.xz || fail "cannot unpack test files"
mkdir wwwroot && cp http-test-files/test.html wwwroot/ || fail "test.html missing"
rm -rf http-test-files

# 5. Build the server once per runtime, offline.
export DOTNET_CLI_HOME="$HOME" DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
export DOTNET_CLI_WORKLOAD_UPDATE_NOTIFY_DISABLE=1 DOTNET_GENERATE_ASPNET_CERTIFICATE=false
export NUGET_PACKAGES="$HOME/.nuget/packages" MSBUILDDISABLENODEREUSE=1 DOTNET_gcServer=
PROJECT="pts-source/benchmarks/Kestrel.Transport.IoUring.PtsServer/Kestrel.Transport.IoUring.PtsServer.csproj"
mkdir -p "$HOME/nuget-offline" || fail "cannot create the empty NuGet source"

publish() {
    local rt="$1"
    echo "Publishing PtsServer for .NET $rt (offline)"
    DOTNET_ROOT="$HOME/dotnet$rt" "$HOME/dotnet$rt/dotnet" publish "$PROJECT" -c Release \
        --source "$HOME/nuget-offline" -p:NuGetAudit=false -p:UseSharedCompilation=false \
        -p:PtsTargetFramework="net$rt.0" -p:PtsLibraryTfm=net10.0 -o "publish/net$rt" \
        > "publish-net$rt.log" 2>&1 || { tail -n 30 "publish-net$rt.log"; fail "dotnet publish for net$rt failed"; }
    [ -f "publish/net$rt/PtsServer.dll" ] || fail "publish/net$rt/PtsServer.dll missing"
}

rm -rf publish
publish 10
publish 11

# Build servers (MSBuild, Razor, Roslyn) outlive the build and would compete with the benchmark for CPU.
for rt in 10 11; do
    [ -x "$HOME/dotnet$rt/dotnet" ] && DOTNET_ROOT="$HOME/dotnet$rt" "$HOME/dotnet$rt/dotnet" build-server shutdown > /dev/null 2>&1
done

# 6. Run wrapper (PTS runs ./aspnet-kestrel-iouring <options> for every repetition).
cat > aspnet-kestrel-iouring <<'EOF' || fail "cannot write the run wrapper"
#!/bin/sh
exec bash "$HOME/pts-source/phoronix/runtime/run-test.sh" "$@"
EOF
chmod +x aspnet-kestrel-iouring || fail "cannot make the run wrapper executable"

echo "$SOURCE_COMMIT" > source-commit || fail "cannot record the source commit"
echo 0 > ~/install-exit-status
